{
  "name": "vybe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace @vybe/backend",
    "dev:api": "npm run dev:backend",
    "dev:frontend": "npm run dev --workspace @vybe/frontend",
    "build": "npm run build --workspaces --if-present",
    "start": "npm start --workspace @vybe/backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "coordinator": "npm run coordinator --workspace @vybe/backend --",
    "test": "npm test --workspace @vybe/backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
