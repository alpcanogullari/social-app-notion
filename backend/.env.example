PORT=3001
APP_DATA_DIR=.data
# Set to true when running behind HTTPS.
COOKIE_SECURE=false
# Browser origin allowed to make changes to the API.
WEB_ORIGIN=http://127.0.0.1:5173
# Demo only: anyone can use moderator endpoints, including anonymous visitors.
# Set false before public deployment; then a signed-in moderator role is required.
OPEN_MODERATOR_MODE=true
